# Gemini proxy: URL of the Cloudflare Worker in proxy/ (see proxy/README.md).
# The Gemini key itself lives only in the Worker as a secret — never in this file.
GEMINI_PROXY_URL=
# Firebase Web config (Project settings -> Your apps -> Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
